{
  "name": "glui",
  "version": "0.2.0",
  "description": "GLUI (Glue UI) \u2014 one desktop workspace for Claude Code, Codex, and OpenCode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Youssef2430/clui.git"
  },
  "bugs": {
    "url": "https://github.com/Youssef2430/clui/issues"
  },
  "homepage": "https://github.com/Youssef2430/clui#readme",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build:workspace && npm run dev:overlay",
    "build": "npm run build:workspace && npm run build:overlay",
    "preview": "electron-vite preview",
    "dist": "node scripts/workspace.mjs package",
    "dist:dmg": "node scripts/workspace.mjs dmg",
    "doctor": "bash scripts/doctor.sh",
    "postinstall": "electron-builder install-app-deps && bash scripts/patch-dev-icon.sh",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "smoke:pill-ui": "node scripts/smoke-pill-ui.mjs",
    "dist:local": "node scripts/workspace.mjs package",
    "dev:overlay": "npm run build:glass && unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "build:overlay": "npm run build:glass && electron-vite build",
    "preview:overlay": "electron-vite preview",
    "typecheck:overlay": "tsc --noEmit",
    "test:overlay": "tsx --test tests/*.test.ts",
    "check:overlay": "npm run typecheck && npm test && npm run build",
    "smoke:electron:overlay": "node scripts/smoke-electron.mjs",
    "dist:overlay": "npm run build:glass && electron-vite build --mode production && electron-builder --mac --dir",
    "dist:dmg:overlay": "npm run build:glass && electron-vite build --mode production && electron-builder --mac",
    "dist:local:overlay": "npm run build && electron-builder --mac --dir --publish never -c.mac.identity=- -c.mac.notarize=false",
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "setup": "node scripts/workspace.mjs install",
    "cli": "node scripts/workspace.mjs cli",
    "serve": "node scripts/workspace.mjs serve",
    "dev:workspace": "node scripts/workspace.mjs dev",
    "build:workspace": "node scripts/workspace.mjs build",
    "preview:workspace": "node scripts/workspace.mjs start",
    "typecheck:workspace": "node scripts/workspace.mjs typecheck",
    "test:workspace": "node scripts/workspace.mjs test",
    "dist:workspace": "node scripts/workspace.mjs package",
    "dist:dmg:workspace": "node scripts/workspace.mjs dmg",
    "dist:local:workspace": "node scripts/workspace.mjs package",
    "dist:release": "node scripts/workspace.mjs release",
    "build:glass": "node scripts/build-glass.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.35.1",
    "katex": "^0.16.43",
    "node-pty": "^1.1.0",
    "react-markdown": "^9.0.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.clui.app",
    "productName": "GLUI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "resources/**/*",
      "package.json",
      "!node_modules/@huggingface/transformers/.cache"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "resources/native/*.node"
    ],
    "publish": {
      "provider": "github",
      "owner": "Youssef2430",
      "repo": "clui",
      "channel": "latest-arm64"
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "GLUI uses your microphone to transcribe voice input locally with Whisper."
      }
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "44.4.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "node-api-headers": "^1.6.0",
    "pnpm": "11.10.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=24.13.1"
  }
}
